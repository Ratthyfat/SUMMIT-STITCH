<div class="page-width">
  <header class="collection-header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div>{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid{% if collection.products.size <= 2 %} product-grid--two{% endif %}" role="list">
        {%- for product in collection.products -%}
          <li>
            {% render 'card-product', product: product %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p style="text-align: center; font-style: italic; padding: var(--space-4) 0;">
        Nothing here yet — new pieces are on the needles.
      </p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">&larr; Previous</a>
        {%- endif -%}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">Next &rarr;</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    }
  ]
}
{% endschema %}
