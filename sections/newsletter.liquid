<section class="section newsletter">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-status">Thanks — you're on the list.</p>
      {%- else -%}
        <div class="inline-form">
          <label for="NewsletterEmail" class="visually-hidden">Email</label>
          <input
            id="NewsletterEmail"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="Your email"
            required
            autocomplete="email"
          >
          <button type="submit" class="button">Sign up</button>
        </div>
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be first to know about new drops."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Small batches sell through. We'll write when something new comes off the needles — nothing more."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
