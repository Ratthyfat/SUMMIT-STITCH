<section class="section">
  <div class="page-width">
    <div class="section__heading">
      {%- if section.settings.eyebrow != blank -%}
        <span class="label rich-text__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading | default: section.settings.collection.title }}</h2>
    </div>

    {%- if section.settings.collection != blank -%}
      <ul class="product-grid{% if section.settings.collection.products.size <= 2 %} product-grid--two{% endif %}" role="list">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li>
            {% render 'card-product', product: product %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_view_all and section.settings.collection.products.size > section.settings.products_to_show -%}
        <div style="text-align: center; margin-top: var(--space-3);">
          <a href="{{ section.settings.collection.url }}" class="button button--secondary">View all</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="text-align: center; font-style: italic;">Select a collection to feature in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show “View all” when there are more products",
      "default": true
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
