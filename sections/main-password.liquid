<div class="password-page">
  <span class="label" style="color: var(--color-sage);">Colorado Springs, CO</span>
  <h1>{{ shop.name }}</h1>
  <p style="font-style: italic;">{{ settings.tagline }}</p>
  <p>We're still at the needles. The shop opens soon.</p>

  {%- form 'storefront_password' -%}
    <div class="field" style="max-width: 20rem; margin: var(--space-2) auto;">
      <label for="Password">Password</label>
      <input id="Password" type="password" name="password" autocomplete="current-password">
    </div>
    <button type="submit" class="button">Enter</button>
    {%- if form.errors -%}
      <p class="form-status form-status--error">Wrong password. Try again.</p>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
