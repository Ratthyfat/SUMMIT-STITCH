<div class="page-width">
  <header class="collection-header">
    <h1>{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 8 -%}
    <ul class="article-list" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card">
          <span class="label article-card__date">{{ article.published_at | date: '%B %e, %Y' }}</span>
          <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
        </li>
      {%- else -%}
        <li><p style="font-style: italic; text-align: center;">No entries yet.</p></li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
