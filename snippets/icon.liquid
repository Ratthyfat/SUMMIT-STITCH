{%- comment -%}
  Usage: {% render 'icon', icon: 'cart' %}
  Icons: cart, close, menu, search, account, instagram, tiktok
  Thin-stroke, quiet icons — no filled shapes.
{%- endcomment -%}

{%- case icon -%}
  {%- when 'cart' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M5 8h14l-1.2 11.2a1.5 1.5 0 0 1-1.5 1.3H7.7a1.5 1.5 0 0 1-1.5-1.3L5 8Z"/>
      <path d="M8.5 10V6.5a3.5 3.5 0 0 1 7 0V10"/>
    </svg>
  {%- when 'close' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M5 5l14 14M19 5L5 19"/>
    </svg>
  {%- when 'menu' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  {%- when 'search' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="6.5"/>
      <path d="M16 16l5 5"/>
    </svg>
  {%- when 'account' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8" r="3.5"/>
      <path d="M5 20a7 7 0 0 1 14 0"/>
    </svg>
  {%- when 'instagram' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="16" height="16" rx="4"/>
      <circle cx="12" cy="12" r="3.5"/>
      <circle cx="16.8" cy="7.2" r="0.8" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="M14 4v9.5a3.75 3.75 0 1 1-3.75-3.75"/>
      <path d="M14 5.5c.6 2.2 2.2 3.6 4.5 3.9"/>
    </svg>
{%- endcase -%}
